{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_title": "YOLO-Master F1 Platform Kernel Schema Registry",
  "_version": "1.0.0",
  "_owner": "F1",
  "schemas": {
    "JobRequest": {
      "$defs": {
        "ErrorInfo": {
          "description": "Structured error attached to a ``FAILED`` job transition.",
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "timestamp": {
              "title": "Timestamp",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ErrorInfo",
          "type": "object"
        },
        "JobStatus": {
          "description": "Lifecycle state of a job, enforced by the dispatcher state machine.",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ],
          "title": "JobStatus",
          "type": "string"
        },
        "Metadata": {
          "description": "Job bookkeeping metadata attached to every ``JobRequest``.",
          "properties": {
            "created_at": {
              "title": "Created At",
              "type": "string"
            },
            "created_by": {
              "default": "anonymous",
              "title": "Created By",
              "type": "string"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Description"
            },
            "priority": {
              "default": "normal",
              "title": "Priority",
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "title": "Tags",
              "type": "array"
            }
          },
          "title": "Metadata",
          "type": "object"
        },
        "OutputConfig": {
          "description": "Output destination and artifact-capture policy for a job.",
          "properties": {
            "output_dir": {
              "default": "runs/predict/job_20260824_f1_001",
              "title": "Output Dir",
              "type": "string"
            },
            "save_images": {
              "default": true,
              "title": "Save Images",
              "type": "boolean"
            },
            "save_labels": {
              "default": false,
              "title": "Save Labels",
              "type": "boolean"
            },
            "save_logs": {
              "default": true,
              "title": "Save Logs",
              "type": "boolean"
            },
            "artifacts": {
              "items": {
                "type": "string"
              },
              "title": "Artifacts",
              "type": "array"
            }
          },
          "title": "OutputConfig",
          "type": "object"
        },
        "RuntimeTracking": {
          "description": "Phase 1 runtime supervision knobs: streaming, deadline and cancellation.",
          "properties": {
            "stream_logs": {
              "default": true,
              "title": "Stream Logs",
              "type": "boolean"
            },
            "timeout_seconds": {
              "default": 300,
              "title": "Timeout Seconds",
              "type": "integer"
            },
            "cancellable": {
              "default": true,
              "title": "Cancellable",
              "type": "boolean"
            },
            "cancel_requested": {
              "default": false,
              "title": "Cancel Requested",
              "type": "boolean"
            }
          },
          "title": "RuntimeTracking",
          "type": "object"
        },
        "SecurityConstraints": {
          "description": "Fail-closed security policy enforced before and during job execution.\n\nRegex-enhanced whitelisting (P1): ``allowed_path_patterns`` holds additional\nregex patterns accepted by ``BaseTaskHandler._is_path_safe``. Patterns are\nmatched against the normalized resolved POSIX path and must consume the\nentire path string; malformed patterns fail closed. For backward\ncompatibility, entries in ``allowed_paths`` starting with ``^`` are also\ninterpreted as regex patterns by the handler layer.",
          "properties": {
            "path_whitelisted": {
              "default": true,
              "title": "Path Whitelisted",
              "type": "boolean"
            },
            "allow_shell": {
              "default": false,
              "title": "Allow Shell",
              "type": "boolean"
            },
            "allowed_paths": {
              "items": {
                "type": "string"
              },
              "title": "Allowed Paths",
              "type": "array"
            },
            "allowed_path_patterns": {
              "items": {
                "type": "string"
              },
              "title": "Allowed Path Patterns",
              "type": "array"
            }
          },
          "title": "SecurityConstraints",
          "type": "object"
        },
        "TaskType": {
          "description": "Task identifier accepted by the job dispatcher and handler registry.",
          "enum": [
            "predict",
            "train",
            "export",
            "diagnose",
            "val"
          ],
          "title": "TaskType",
          "type": "string"
        }
      },
      "description": "Strongly typed job submission contract shared by UI, skills and dispatcher.\n\nAttributes:\n    job_id: Unique job identifier (``{task_type}_{timestamp}_{uuid}`` from the UI).\n    task_type: Registered task type resolved by the handler registry.\n    status: Current lifecycle state; transitions are FSM-enforced.\n    metadata: Bookkeeping metadata (author, priority, tags, timestamps).\n    params: Task-specific parameters validated by the resolved handler.\n    output: Output directory and artifact capture configuration.\n    security_constraints: Fail-closed security policy for the job.\n    runtime_tracking: Deadline, streaming and cooperative-cancellation flags.\n    error: Structured failure detail; ``None`` while the job is not FAILED.\n    logs: Sanitized in-memory execution log lines; only written through\n        :meth:`append_log`, which redacts credentials before storage so\n        UI-facing and persisted logs never carry plaintext secrets.",
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/TaskType"
        },
        "status": {
          "$ref": "#/$defs/JobStatus",
          "default": "pending"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata",
          "default": {
            "created_at": "2026-09-05T03:00:45.905711+00:00",
            "created_by": "anonymous",
            "description": null,
            "priority": "normal",
            "tags": []
          }
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/OutputConfig",
          "default": {
            "output_dir": "runs/predict/job_20260824_f1_001",
            "save_images": true,
            "save_labels": false,
            "save_logs": true,
            "artifacts": []
          }
        },
        "security_constraints": {
          "$ref": "#/$defs/SecurityConstraints",
          "default": {
            "path_whitelisted": true,
            "allow_shell": false,
            "allowed_paths": [],
            "allowed_path_patterns": []
          }
        },
        "runtime_tracking": {
          "$ref": "#/$defs/RuntimeTracking",
          "default": {
            "stream_logs": true,
            "timeout_seconds": 300,
            "cancellable": true,
            "cancel_requested": false
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logs": {
          "items": {
            "type": "string"
          },
          "title": "Logs",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "task_type"
      ],
      "title": "JobRequest",
      "type": "object"
    },
    "JobStatus": {
      "enum": "JobStatus",
      "values": [
        "pending",
        "running",
        "completed",
        "failed"
      ],
      "names": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ]
    },
    "ArtifactManifest": {
      "description": "Structured artifact manifest capturing the minimal fields from Appendix B.",
      "properties": {
        "experiment_id": {
          "description": "Unique experiment identifier, e.g. topic_seed_timestamp",
          "title": "Experiment Id",
          "type": "string"
        },
        "git_ref": {
          "description": "Version control anchor: tag + commit SHA",
          "title": "Git Ref",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "description": "Configuration file path and hash",
          "title": "Config",
          "type": "object"
        },
        "dataset": {
          "description": "Dataset name, version, split, and sample count",
          "title": "Dataset",
          "type": "string"
        },
        "hardware": {
          "description": "Hardware spec: GPU/CPU, VRAM, driver, CUDA/TRT version",
          "title": "Hardware",
          "type": "string"
        },
        "budget": {
          "description": "Resource budget: epochs, batch size, imgsz, GPU-hours",
          "title": "Budget",
          "type": "string"
        },
        "seed": {
          "description": "Explicit random seed value",
          "title": "Seed",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": true,
          "description": "Primary metrics, aux metrics, and confidence intervals",
          "title": "Metrics",
          "type": "object"
        },
        "artifact": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping of artifact roles to paths and checksums",
          "title": "Artifact",
          "type": "object"
        },
        "status": {
          "description": "Execution outcome: success, failed, or inconclusive",
          "title": "Status",
          "type": "string"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Known constraints: single seed, scale, backend limitations",
          "title": "Limitation"
        }
      },
      "required": [
        "experiment_id",
        "git_ref",
        "dataset",
        "hardware",
        "budget",
        "seed",
        "status"
      ],
      "title": "ArtifactManifest",
      "type": "object"
    },
    "SecurityConstraints": {
      "description": "Fail-closed security policy enforced before and during job execution.\n\nRegex-enhanced whitelisting (P1): ``allowed_path_patterns`` holds additional\nregex patterns accepted by ``BaseTaskHandler._is_path_safe``. Patterns are\nmatched against the normalized resolved POSIX path and must consume the\nentire path string; malformed patterns fail closed. For backward\ncompatibility, entries in ``allowed_paths`` starting with ``^`` are also\ninterpreted as regex patterns by the handler layer.",
      "properties": {
        "path_whitelisted": {
          "default": true,
          "title": "Path Whitelisted",
          "type": "boolean"
        },
        "allow_shell": {
          "default": false,
          "title": "Allow Shell",
          "type": "boolean"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "allowed_path_patterns": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Path Patterns",
          "type": "array"
        }
      },
      "title": "SecurityConstraints",
      "type": "object"
    }
  }
}